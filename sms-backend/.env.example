PORT=3000
# VPS/public: giữ 0.0.0.0 để app Expo điện thoại gọi được (không bind chỉ 127.0.0.1).
HOST=0.0.0.0
FRONTEND_ORIGIN=*

# App sends this via header: x-api-key
SMS_API_KEY=change_me_to_a_strong_key

# VietGuys CSKH OTP credentials (IP outbound của server phải được VietGuys whitelist hoặc báo lỗi −7)
VIETGUYS_CSKH_URL=https://cloudsms4.vietguys.biz:4438/api/index.php
# Generate Access Token: https://developers.vietguys.biz/#generate-access-token
VIETGUYS_TOKEN_URL=https://api-v2.vietguys.biz:4438/token/v1/refresh
VIETGUYS_USERNAME=your_account
# Refresh Token: ai.vietguys.biz → Profile → Settings V4. Khi có dòng này, backend tự POST refresh và dùng access_token làm pwd (không cần Pwd tĩnh).
VIETGUYS_REFRESH_TOKEN=
# Pwd / token tĩnh — chỉ dùng khi KHÔNG đặt VIETGUYS_REFRESH_TOKEN (Profile → Token Field "Pwd").
VIETGUYS_PASSCODE=
VIETGUYS_ACCESS_TOKEN=
VIETGUYS_BRANDNAME=VIETGUYS
VIETGUYS_PID=
# 1 = log URL + multipart fields to stdout (pwd shown as [REDACTED]) — for debugging/support tickets
VIETGUYS_DEBUG_LOG=

OTP_TTL_MS=300000

# PayOS credentials (from https://my.payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Supabase (for webhook wallet top-up)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
