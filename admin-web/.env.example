# Copy to .env.local and điền URL + anon key từ Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Trùng profiles.id tài khoản admin (và cùng giá trị với EXPO_PUBLIC_ADMIN_USER_ID trong app)
NEXT_PUBLIC_ADMIN_USER_ID=04e2f077-bbd9-4364-b34c-e4c88ba0d346
NEXT_PUBLIC_ADMIN_DISPLAY_NAME=Support Zena
