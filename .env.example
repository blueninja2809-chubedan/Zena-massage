EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_SCHEMA=public

# Enable local mock data for therapists + booking + chat.
# Set to "true" to bypass Supabase calls and run in-memory test mode.
EXPO_PUBLIC_TEST_MODE=false

# Google: bật provider trong Supabase → Authentication → Providers.
# Thêm redirect app (ví dụ massagenow:// từ expo.scheme) vào Authentication → URL Configuration.
# Các biến dưới chỉ cần nếu bạn dùng flow Google SDK / id_token riêng (không bắt buộc cho OAuth qua Supabase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# SMS / API backend (được dùng trong smsService.ts và payosService.ts)
EXPO_PUBLIC_SMS_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SMS_API_KEY=change_me_to_a_strong_key
EXPO_PUBLIC_SMS_API_TIMEOUT_MS=12000
