EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_SCHEMA=public

# Cùng UUID với admin-web .env: NEXT_PUBLIC_ADMIN_USER_ID (profiles.id của tài khoản admin) — cần cho chat KTV ↔ admin
# Mặc định trong app: 04e2f077-bbd9-4364-b34c-e4c88ba0d346 / Support Zena (constants/adminSupport.ts)
EXPO_PUBLIC_ADMIN_USER_ID=04e2f077-bbd9-4364-b34c-e4c88ba0d346
EXPO_PUBLIC_ADMIN_DISPLAY_NAME=Support Zena

# App Store 3.1.2 — Terms of Use (EULA) & Privacy Policy (functional HTTPS URLs in the subscription UI)
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://zenavietnam.com/dieu-khoan-su-dung/


# Mapbox — màn quét KTV (@rnmapbox/maps). Bắt buộc pk.* cho tiles; thêm trong `.env` local / EAS (`EXPO_PUBLIC_*`).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Token tải SDK native (secret sk., quyền Downloads:Read) — nếu Pod/Gradle báo thiếu khi prebuild; EAS Secrets hoặc `.env` local, không commit.
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
# MAPBOX_DOWNLOADS_TOKEN=

# Native Mapbox: false = fallback OSM + radar (Expo Go / chưa prebuild @rnmapbox/maps).
EXPO_PUBLIC_ENABLE_NATIVE_MAPS=true

# Checklist Mapbox:
# 1) Điền EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN (pk) + (nếu cần) RNMAPBOX_MAPS_DOWNLOAD_TOKEN cho prebuild.
# 2) `npx expo prebuild --clean` rồi `npx expo run:ios` / `run:android` hoặc EAS Build — không dùng Expo Go để test bản đồ native.
# 3) EAS: thêm biến vào build profile env hoặc Secrets trên expo.dev.

# Google (tuỳ chọn ghi chú): luồng đăng nhập trong app đi qua Supabase OAuth + WebBrowser — cấu hình Web client + Secret trên Supabase.
# Thêm massagenow:// và URL dev Expo vào Supabase → Redirect URLs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# App Store review toggles.
# - EXPO_PUBLIC_APP_REVIEW_MODE=true: force-hide risky surfaces in this build.
# - EXPO_PUBLIC_HIDE_*: manual fallback override.
# App also auto-hides on iOS when current app version > live App Store version.
# Verbose console: debugLog() in app + Expo debug (use npm run dev:debug)
EXPO_PUBLIC_DEBUG_LOGS=0
# E2E only: allow booking without login (ServiceBookingScreen)
EXPO_PUBLIC_E2E_ALLOW_UNSIGNED=0

EXPO_PUBLIC_APP_REVIEW_MODE=false
EXPO_PUBLIC_HIDE_SOCIAL_AUTH=false
EXPO_PUBLIC_HIDE_VIP_SUBSCRIPTION=false

# SMS / API backend (OTP VietGuys qua sms-backend + PayOS proxy).
#
# QUAN TRỌNG: localhost / 127.0.0.1 chỉ ổn cho Simulator chạy trên CÙNG máy với backend.
# iPhone / Android thật: 127.0.0.1 là CHÍNH ĐIỆN THOẠI → luôn lỗi kết nối OTP.
#
# Production (Hostinger HTTPS proxy → sms-backend): base URL không có /
# VD: https://darkslategrey-weasel-236739.hostingersite.com (TLS chuẩn, hợp mạng 4G; tránh chỉ HTTP + IP VPS).
# Nếu còn VPS thẳng: http://PUBLIC_IP:3000 — sms-backend HOST=0.0.0.0; firewall mở TCP. IP HTTP → thêm NSExceptionDomains trong app.json.
# Cùng Wi‑Fi (dev): http://192.168.x.x:3000 (IP LAN máy Mac).
# Dev: npm run dev:with-sms
EXPO_PUBLIC_SMS_API_BASE_URL=https://darkslategrey-weasel-236739.hostingersite.com
EXPO_PUBLIC_SMS_API_KEY=change_me_to_a_strong_key
# Phải >= thời gian tối đa sms-backend chờ VietGuys (refresh token 12s + gửi SMS 9s ≈ 21s) + độ trễ mạng.
EXPO_PUBLIC_SMS_API_TIMEOUT_MS=30000
# false = tắt OTP SMS đăng ký (chỉ SĐT+mật khẩu). Rebuild EAS sau khi đổi.
EXPO_PUBLIC_SMS_OTP_SIGNUP=true
