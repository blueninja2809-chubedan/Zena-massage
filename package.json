{
  "name": "massage-now",
  "main": "expo-router/entry",
  "version": "1.0.11",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "dev:with-sms": "bash scripts/dev-with-sms.sh",
    "deploy:sms-vps": "bash sms-backend/scripts/deploy-from-mac.sh",
    "dev:debug": "EXPO_DEBUG=1 DEBUG=expo:* expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:clean": "cd android && gradlew.bat clean",
    "ios": "PATH=\"$(ruby -r rubygems -e 'print File.join(Gem.user_dir, %q{bin})'):$PATH\" RUBYOPT=-rlogger npx expo run:ios",
    "ios:quick": "PATH=\"$(ruby -r rubygems -e 'print File.join(Gem.user_dir, %q{bin})'):$PATH\" RUBYOPT=-rlogger npx expo run:ios --no-install",
    "ios:after-lock": "bash scripts/ios-fix-build-db-and-run.sh",
    "ios:device": "bash scripts/run-ios-device.sh",
    "ios:cache": "rm -rf .expo node_modules/.cache/metro node_modules/.cache/babel-loader",
    "ios:clean": "bash scripts/ios-dev-clean.sh",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "lint": "expo lint",
    "supabase:proxy": "node ./scripts/supabase-proxy.mjs",
    "apple:client-secret": "node ./scripts/generate-apple-client-secret.mjs",
    "setup:android-env": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-android-env.ps1",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@rnmapbox/maps": "^10.2.10",
    "@supabase/supabase-js": "^2.99.2",
    "expo": "~55.0.18",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-location": "~55.1.8",
    "expo-notifications": "~55.0.21",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.14",
    "lottie-react": "^2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-iap": "15.2.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "@types/semver": "^7.7.1",
    "eas-cli": "^18.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
